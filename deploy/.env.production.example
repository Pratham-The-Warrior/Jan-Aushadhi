# =============================================
# JAN AUSHADHI — PRODUCTION ENVIRONMENT CONFIG
# =============================================
# Copy this file to deploy/.env.production on the
# production server and fill in ALL values.
#
# ⚠️  NEVER commit the filled-in version to git!
# =============================================

# ---- Base Domain Configuration ----
# Required for Nginx reverse proxy, SSL certificates, and CORS
DOMAIN=yourdomain.com

# ---- Images (built and published by GitHub Actions) ----
# deploy.sh pulls ${IMAGE_REGISTRY}/{backend,frontend,seller,admin}:${IMAGE_TAG}.
# Pin IMAGE_TAG to a commit SHA to deploy (or roll back to) an exact build.
IMAGE_REGISTRY=ghcr.io/pratham-the-warrior/jan-aushadhi
IMAGE_TAG=latest

# ---- Server ----
NODE_ENV=production
PORT=5000

# ---- PostgreSQL + PostGIS ----
POSTGRES_USER=janaushadhi_prod
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
POSTGRES_DB=janaushadhi
# DATABASE_URL is built from the POSTGRES_* values above (URL-encoded, host
# "postgres"), so generated passwords with / + = work. Only set DATABASE_URL to
# use an external database instead.

# ---- Redis Cache ----
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24
# REDIS_URL is built from REDIS_PASSWORD (host "redis"); only set it for an external Redis.

# ---- Meilisearch Search Engine ----
# IMPORTANT: Meilisearch in production requires a master key >= 16 bytes!
MEILI_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ---- Firebase Admin SDK ----
# Supports:
#   1. Raw JSON string (single-line)
#   2. Path to JSON file (e.g. /app/serviceAccountKey.json)
#   3. Base64 encoded JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Twilio WhatsApp Bridge (optional: leave empty to disable) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ---- CORS (restrict to your deployed domains) ----
CORS_ORIGIN=https://app.yourdomain.com,https://seller.yourdomain.com,https://admin.yourdomain.com

# ---- Frontend build arguments ----
# Only used by `deploy.sh --build`. The published images are built by CI from
# the GitHub Actions secrets of the same names (see docs/DEPLOY_DIGITALOCEAN.md).
VITE_API_URL=https://api.yourdomain.com
# Patient site origin for social previews (defaults to https://app.${DOMAIN})
# VITE_SITE_URL=https://app.yourdomain.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
