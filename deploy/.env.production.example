# =============================================
# JAN AUSHADHI — PRODUCTION ENVIRONMENT CONFIG
# =============================================
# Copy this file to deploy/.env.production on the
# production server and fill in ALL values.
#
# ⚠️  NEVER commit the filled-in version to git!
# =============================================

# ---- Server ----
NODE_ENV=production
PORT=5000

# ---- PostgreSQL + PostGIS ----
POSTGRES_USER=janaushadhi_prod
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
POSTGRES_DB=janaushadhi
DATABASE_URL=postgresql://janaushadhi_prod:CHANGE_ME@postgres:5432/janaushadhi

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24
REDIS_URL=redis://default:CHANGE_ME@redis:6379

# ---- Meilisearch ----
MEILI_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ---- Firebase Admin SDK ----
# Paste the FULL service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Twilio WhatsApp ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+16625024421

# ---- CORS (restrict to your domains) ----
CORS_ORIGIN=https://janaushadhi.site,https://seller.janaushadhi.site,https://admin.janaushadhi.site

# ---- Frontend Build Args (used by docker-compose build) ----
VITE_API_URL=https://api.janaushadhi.site
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
