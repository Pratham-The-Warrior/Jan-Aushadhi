# =============================================
# JAN AUSHADHI — PRODUCTION ENVIRONMENT CONFIG
# =============================================
# Copy this file to deploy/.env.production on the
# production server and fill in ALL values.
#
# ⚠️  NEVER commit the filled-in version to git!
# =============================================

# ---- Base Domain Configuration ----
# Required for Nginx reverse proxy, SSL certificates, and CORS
DOMAIN=yourdomain.com

# ---- Server ----
NODE_ENV=production
PORT=5000

# ---- PostgreSQL + PostGIS ----
POSTGRES_USER=janaushadhi_prod
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
POSTGRES_DB=janaushadhi
DATABASE_URL=postgresql://janaushadhi_prod:CHANGE_ME@postgres:5432/janaushadhi
DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Redis Cache ----
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24
REDIS_URL=redis://default:CHANGE_ME@redis:6379

# ---- Meilisearch Search Engine ----
# IMPORTANT: Meilisearch in production requires a master key >= 16 bytes!
MEILI_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ---- Firebase Admin SDK ----
# Supports:
#   1. Raw JSON string (single-line)
#   2. Path to JSON file (e.g. /app/serviceAccountKey.json)
#   3. Base64 encoded JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Twilio WhatsApp Bridge ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+16625024421

# ---- CORS (restrict to your deployed domains) ----
CORS_ORIGIN=https://app.yourdomain.com,https://seller.yourdomain.com,https://admin.yourdomain.com

# ---- Frontend Build Arguments (baked during docker compose build) ----
VITE_API_URL=https://api.yourdomain.com/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
