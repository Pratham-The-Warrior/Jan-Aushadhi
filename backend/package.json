{
  "name": "janaushadhi-backend",
  "version": "1.0.0",
  "description": "Jan Aushadhi Hyper-Local Medicine Discovery & Commerce Platform API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc --noEmit && esbuild src/index.ts scripts/migrate.ts scripts/etl_pipeline.ts scripts/store_geocoding.ts scripts/seed_meilisearch.ts scripts/build_matches.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "etl:run": "tsx scripts/etl_pipeline.ts",
    "etl:stores": "tsx scripts/store_geocoding.ts",
    "meili:seed": "tsx scripts/seed_meilisearch.ts",
    "match:build": "tsx scripts/build_matches.ts",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "keywords": [
    "janaushadhi",
    "healthcare",
    "generics",
    "postGIS"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4",
    "firebase-admin": "^13.8.0",
    "meilisearch": "^0.57.0",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
