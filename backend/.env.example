# ===========================================
# JAN AUSHADHI BACKEND — ENVIRONMENT CONFIG
# ===========================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.
# Production values for each host are listed in docs/ENVIRONMENT.md.
# ===========================================

# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated origins allowed to call the API (your three sites). Default: any.
# CORS_ORIGIN=https://janaushadhi.example,https://seller.janaushadhi.example,https://admin.janaushadhi.example

# ---- PostgreSQL + PostGIS ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/janaushadhi"
# TLS is turned on automatically for known cloud hosts (Supabase, Neon, Render…);
# force it with DB_SSL=true / DB_SSL=false.
# Supabase's pooler certificate isn't in Node's trust store: either set
# DB_SSL_REJECT_UNAUTHORIZED=false, or (better) put Supabase's CA certificate
# (PEM, or base64 of the PEM) in DB_SSL_CA to verify it.
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=
# DB_POOL_MAX=20

# Migrations run automatically at startup. Set to false if you run
# `npm run db:migrate` yourself as a release step.
# RUN_MIGRATIONS_ON_START=true

# ---- Redis (optional cache; the API works without it) ----
REDIS_URL="redis://localhost:6379"
# Upstash / TLS:  REDIS_URL="rediss://default:<password>@<host>:6379"

# ---- Meilisearch (optional; search falls back to PostgreSQL without it) ----
MEILI_HOST="http://localhost:7700"
# At least 16 characters in production: openssl rand -base64 32
MEILI_MASTER_KEY="masterKey"

# ---- Firebase Admin SDK (required for sign-in, orders, seller and admin) ----
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Paste the JSON on one line, base64-encode it, or give a path to the file.
FIREBASE_SERVICE_ACCOUNT_KEY=''

# ---- Twilio WhatsApp (optional order confirmations) ----
# https://console.twilio.com → Account → API Credentials. Leave empty to disable.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# ---- Reverse proxy & rate limiting ----
# Set TRUST_PROXY=1 when exactly one proxy you control (e.g. nginx) sits in front.
# TRUST_PROXY=true
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW="1 minute"
