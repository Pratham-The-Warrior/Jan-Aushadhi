# ===========================================
# JAN AUSHADHI BACKEND — ENVIRONMENT CONFIG
# ===========================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL + PostGIS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/janaushadhi"

# Meilisearch
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="masterKey"

# Redis
REDIS_URL="redis://localhost:6379"

# Database SSL (set to 'false' for Supabase pooler, 'true' for self-hosted Postgres)
DB_SSL_REJECT_UNAUTHORIZED=false

# Firebase Admin SDK
# Go to Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the FULL JSON (json.stringify'd into one line) here
FIREBASE_SERVICE_ACCOUNT_KEY=''

# Google Maps Geocoding (for store geocoding ETL script)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Twilio WhatsApp
# Get from https://console.twilio.com → Account → API Credentials
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
