# =============================================
# Docker Build Context Exclusions
# Prevents secrets, data files, and dev artifacts
# from leaking into production container images.
# =============================================

# Environment files (secrets) — at any depth, e.g. backend/.env
**/.env
**/.env.*
!**/.env.example
deploy/.env.production

# Version control
.git
.github

# Dependencies (rebuilt inside container)
**/node_modules

# Data files (large CSVs included for automated cloud seeding)
*.pdf

# Build artifacts (rebuilt inside container)
**/dist
**/build

# Development artifacts
scratch/
**/*.log
# (not *.txt: apps/frontend/public/robots.txt must reach the image)
diff_admin.txt
lint_seller.log
lint_seller.txt

# Documentation (not needed in images)
TECHNICAL_DOCUMENTATION.md
WORKFLOWS_DOCUMENTATION.md
README.md

# IDE and OS
.vscode/
.idea/
.DS_Store
*.suo
*.sw?
